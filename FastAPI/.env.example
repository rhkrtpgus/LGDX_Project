APP_NAME=LGDX FastAPI
APP_VERSION=0.1.0
APP_DEBUG=true
API_PREFIX=/fastapi
CORS_ALLOW_ALL=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:4174,http://127.0.0.1:4174
POSTGRES_URL=postgresql://postgres:12345@localhost:3355/lgdx
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=lgdx_monitor
YOUTUBE_API_KEY=
MODEL_TIMEOUT_SECONDS=900
ADDICTION_MONITOR_PYTHON_COMMAND=.venv-monitor\Scripts\python.exe
ADDICTION_MONITOR_MAX_SECONDS=300
ADDICTION_MONITOR_CAMERA_INDEX=0
