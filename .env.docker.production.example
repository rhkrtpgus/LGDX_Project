# Copy this file to .env.docker on the real server and fill in the placeholders.

POSTGRES_DB=lgdx
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_PORT=3355

MONGO_PORT=27017
MONGODB_DATABASE=lgdx_monitor

NGINX_PORT=80
SPRING_PORT=8082
SPRING_SQL_INIT_MODE=always
FASTAPI_PORT=8000

FASTAPI_APP_NAME=LGDX FastAPI
FASTAPI_APP_VERSION=0.1.0
FASTAPI_APP_DEBUG=false
FASTAPI_API_PREFIX=/fastapi
CORS_ALLOW_ALL=false
CORS_ORIGINS=https://YOUR_DOMAIN

MODEL_PYTHON_COMMAND=python
MODEL_TIMEOUT_SECONDS=900
ADDICTION_MONITOR_PYTHON_COMMAND=python
ADDICTION_MONITOR_MAX_SECONDS=300
ADDICTION_MONITOR_CAMERA_INDEX=0

VITE_JAVA_API_BASE_URL=/api
VITE_FASTAPI_API_BASE_URL=/fastapi
VITE_JAVA_PROXY_TARGET=http://back:8082
VITE_FASTAPI_PROXY_TARGET=http://fastapi:8000

# Production usage:
# 1. First boot only: keep SPRING_SQL_INIT_MODE=always so schema.sql/data.sql initialize the DB.
# 2. After the first successful boot and data initialization: change SPRING_SQL_INIT_MODE=never.
# 3. Restart the stack after changing the value.
