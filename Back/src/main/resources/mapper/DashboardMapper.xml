<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.repository.DashboardMapper">

  <resultMap id="recentAlertResultMap" type="com.example.demo.dto.RecentAlertResponse">
    <id property="alertId" column="alert_id" />
    <result property="alertType" column="alert_type" />
    <result property="riskLevel" column="risk_level" />
    <result property="messageText" column="message_text" />
    <result property="videoId" column="video_id" />
    <result property="watchTime" column="watch_time" />
  </resultMap>

  <select id="countUsers" resultType="int">
    SELECT COUNT(*)
    FROM "User"
  </select>

  <select id="countChildren" resultType="int">
    SELECT COUNT(*)
    FROM "Child"
  </select>

  <select id="countViewings" resultType="int">
    SELECT COUNT(*)
    FROM "ViewingHistory"
  </select>

  <select id="countAlerts" resultType="int">
    SELECT COUNT(*)
    FROM "AlertLog"
  </select>

  <select id="findRecentAlerts" resultMap="recentAlertResultMap">
    SELECT
      a."alert_id" AS alert_id,
      a."alert_type" AS alert_type,
      a."risk_level" AS risk_level,
      a."message_text" AS message_text,
      v."video_id" AS video_id,
      v."watch_time" AS watch_time
    FROM "AlertLog" a
    JOIN "ViewingHistory" v
      ON v."viewing_id" = a."viewing_id"
    ORDER BY v."watch_time" DESC NULLS LAST, a."alert_id" DESC
    LIMIT #{limit}
  </select>

</mapper>
